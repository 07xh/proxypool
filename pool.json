{
  "api": {
    "host": "127.0.0.1",
    "port": 18081,
    "token": ""
  },
  "gateway": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 18080,
    "auth": "",
    "max_retry": 2,
    "retry_on_status": [
      502,
      503,
      504
    ],
    "direct_fallback": false,
    "connect_timeout": 15,
    "idle_timeout": 120,
    "rhythm_enabled": true,
    "shape_headers": true
  },
  "checker": {
    "enabled": true,
    "interval": 120,
    "concurrency": 64,
    "timeout": 8,
    "targets": [
      "http://www.gstatic.com/generate_204",
      "http://httpbin.org/ip"
    ],
    "expect_contains": "",
    "content_check": false,
    "startup_sweep": true,
    "max_bytes": 32768
  },
  "hardening": {
    "affinity_ttl": 900,
    "proxy_cooldown": 60,
    "rhythm_mu": 1.6,
    "rhythm_sigma": 0.6,
    "per_key_qps": 0.5,
    "global_qps": 2.0,
    "port_scope_host": "example.com",
    "port_scope_ports": [
      22,
      25,
      6379
    ]
  },
  "pool": {
    "strategy": "weighted_random",
    "sticky_ttl": 300,
    "allow_cold_start": true,
    "max_dead_retry": 3
  },
  "storage": {
    "db": "proxies.db",
    "flush_interval": 5,
    "persist_credentials": false
  },
  "sources": [
    {
      "type": "file",
      "name": "local-list",
      "path": "proxies.local.txt"
    }
  ],
  "log_level": "info",
  "direct_nodes": {
    "path": "direct_nodes.local.txt",
    "allowed_hosts": [
      "kyfw.12306.cn"
    ],
    "max_age_hours": 72
  },
  "public_sources": [
    {
      "name": "monosans-http",
      "url": "https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/http.txt",
      "scheme": "http",
      "enabled": true,
      "interval": 1800,
      "max_entries": 80
    },
    {
      "name": "monosans-socks5",
      "url": "https://raw.githubusercontent.com/monosans/proxy-list/main/proxies/socks5.txt",
      "scheme": "socks5",
      "enabled": true,
      "interval": 1800,
      "max_entries": 80
    }
  ]
}
